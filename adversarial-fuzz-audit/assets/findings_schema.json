{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adversarial-fuzz-audit findings",
  "type": "object",
  "required": ["claim", "verdict", "authors", "adversary", "findings", "scope"],
  "properties": {
    "project": {"type": "string"},
    "date": {"type": "string"},
    "claim": {"type": "string", "description": "The author's assertion under test, one sentence, quoted when possible."},
    "verdict": {"type": "string", "enum": ["HELD", "PARTIALLY HELD", "FELL"]},
    "verdict_reason": {"type": "string"},
    "authors": {
      "type": "object",
      "required": ["code", "tests"],
      "properties": {
        "code": {"type": "array", "items": {"type": "string"}},
        "tests": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string", "description": "git-trailers | user | inferred"}
      }
    },
    "adversary": {
      "type": "object",
      "required": ["model", "vendor", "independence"],
      "properties": {
        "agent": {"type": "string"},
        "model": {"type": "string"},
        "vendor": {"type": "string"},
        "independence": {"type": "string", "enum": ["cross-vendor", "same-vendor-different-model", "same-model-user-override", "api-oracle-only", "unverified-provider"]},
        "user_override": {"type": "boolean"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "severity", "attributed_to", "property", "reproduction", "expected", "actual"],
        "properties": {
          "id": {"type": "string", "pattern": "^F-[0-9]{2,}$"},
          "title": {"type": "string"},
          "type": {"type": "string", "enum": ["spec-violation", "crash", "hang-or-resource", "data-corruption", "security", "test-weakness", "spec-gap"]},
          "severity": {"type": "string", "enum": ["Critical", "High", "Medium", "Low", "Info"]},
          "attributed_to": {"type": "string", "enum": ["code-author", "test-author", "both"]},
          "property": {"type": "string", "description": "The contract or property violated, as a sentence."},
          "reproduction": {
            "type": "object",
            "required": ["command"],
            "properties": {
              "input": {"description": "Inline minimal input or a path under adversarial/"},
              "input_path": {"type": "string"},
              "command": {"type": "string", "description": "Shell command run from the project root. Convention: it must exit NON-ZERO while the defect is present (like a failing test); `report_builder.py --verify` labels exit 0 as NOT REPRODUCED."},
              "expect_exit": {"type": "integer", "description": "Optional. Exact exit code that signals the defect, when it is not simply non-zero (e.g. 0 for a command whose exit 0 means the defect is still there, such as `... | grep -q SURVIVED`)."},
              "seed": {"type": ["string", "integer", "null"]}
            }
          },
          "expected": {"type": "string"},
          "actual": {"type": "string"},
          "why_tests_missed_it": {"type": "string"},
          "location": {"type": "string", "description": "file:line"},
          "also_test_weakness": {"type": "boolean"},
          "independence_note": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "test_weakness": {
      "type": "object",
      "properties": {
        "tautology_index": {"type": "object", "properties": {"count": {"type": "integer"}, "total": {"type": "integer"}, "tests": {"type": "array", "items": {"type": "string"}}}},
        "oracle_strength_mean": {"type": "number"},
        "smells": {"type": "object", "additionalProperties": {"type": "integer"}},
        "mutation": {"type": "object", "properties": {"tool": {"type": "string"}, "score": {"type": "number"}, "tried": {"type": "integer"}, "killed": {"type": "integer"},
                      "survivors": {"type": "array", "items": {"type": "object", "properties": {"location": {"type": "string"}, "mutation": {"type": "string"}, "meaning": {"type": "string"}}}}}}
      }
    },
    "scope": {
      "type": "object",
      "required": ["attacked", "not_attacked"],
      "properties": {
        "attacked": {"type": "array", "items": {"type": "object", "properties": {
          "target": {"type": "string"}, "strategies": {"type": "array", "items": {"type": "string"}}, "tools": {"type": "array", "items": {"type": "string"}},
          "executions": {"type": ["integer", "string", "null"]}, "wall_clock_minutes": {"type": ["number", "null"]}, "coverage_note": {"type": "string"}, "seed": {"type": ["string", "integer", "null"]}}}},
        "not_attacked": {"type": "array", "items": {"type": "object", "properties": {"target": {"type": "string"}, "reason": {"type": "string"}}}}
      }
    },
    "observations": {"type": "array", "items": {"type": "string"}},
    "handback": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}}
  }
}
